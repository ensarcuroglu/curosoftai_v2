@{
    ViewData["Title"] = "Hikayemiz | Curosoftai";
}

@section Styles {
    <link rel="stylesheet" href="~/css/about.css" asp-append-version="true" />
}

<main class="about-page">
    <!-- HERO SECTION -->
    <section class="about-hero" aria-labelledby="aboutHeroHeading">
        <div class="hero-glow" aria-hidden="true"></div>
        <div class="hero-grain" aria-hidden="true"></div>

        <div class="container about-hero-container">
            <div class="about-hero-meta" data-gsap="fade-up">
                <span class="meta-line"></span>
                <span class="meta-text">EST. 2026</span>
            </div>
            <h1 id="aboutHeroHeading" class="about-hero-title">
                <span class="title-line" data-gsap="title-line">Teknolojinin hızını,</span>
                <span class="title-line" data-gsap="title-line">işletmenizin <em class="title-em">gücüne</em></span>
                <span class="title-line" data-gsap="title-line">dönüştürüyoruz.</span>
            </h1>
        </div>
        <div class="scroll-indicator" data-gsap="fade-up" aria-hidden="true">
            <span>Hikayeyi Keşfet</span>
            <div class="indicator-line"></div>
        </div>
    </section>

    <!-- STORY SECTION (Text Reveal) -->
    <section class="story-section">
        <div class="container story-container">
            <div class="story-content">
                <p class="story-text" data-text-reveal>
                    Teknoloji artık doğrusal değil, eksponansiyel bir hızla ilerliyor. Bizim hikayemiz, bu amansız ilerlemenin içinde yatan muazzam potansiyeli fark etmemizle başladı.
                </p>
                <p class="story-text" data-text-reveal>
                    Gözlemlediğimiz bir gerçek vardı: Geleneksel iş modellerine ve mevcut sistemlere doğru teknoloji entegre edildiğinde, ortaya çıkan verimlilik ve karlılık sıçraması tesadüf değildi. Bu, doğru mimarinin kaçınılmaz sonucuydu.
                </p>
                <p class="story-text story-text--highlight" data-text-reveal>
                    Özellikle yapay zekanın gücü artık bir varsayım değil, iş dünyasını yeniden yazan somut bir gerçek. Biz, bu gücü laboratuvardan çıkarıp sahadaki operasyonlarınıza entegre etmek için buradayız.
                </p>
            </div>
        </div>
    </section>

    <!-- MANIFESTO SECTION (Horizontal Scroll) -->
    <section class="manifesto-section" id="manifesto-pin">
        <div class="manifesto-header container">
            <span class="section-tag">Stüdyo Kültürü</span>
            <h2 class="section-title">Neye İnanıyoruz?</h2>
        </div>

        <div class="pin-wrap-container">
            <div class="pin-wrap" id="manifesto-wrap">

                <article class="manifesto-card">
                    <div class="card-num">01</div>
                    <h3>Gürültüyü Filtrelemek</h3>
                    <p>Teknoloji dünyası geçici trendlerle doludur. Biz, karmaşanın içindeki "gürültüyü" filtreler, işletmenize sadece ölçülebilir değer ve net karlılık katacak sağlam mimarilere odaklanırız.</p>
                </article>

                <article class="manifesto-card">
                    <div class="card-num">02</div>
                    <h3>Görünmez Güç</h3>
                    <p>En iyi yazılım, varlığını hissettirmeden hayatı kolaylaştırandır. Kullanıcıyı yormayan, arka planda devasa verileri işleyip size sadece sonuçları sunan sade ve sessiz arayüzler tasarlarız.</p>
                </article>

                <article class="manifesto-card">
                    <div class="card-num">03</div>
                    <h3>Yapay Zeka Gerçekliği</h3>
                    <p>Yapay zekayı bir "pazarlama terimi" olarak değil, süreçleri otomatize eden, maliyetleri düşüren ve insan hatasını minimize eden bir "iş gücü çarpanı" olarak sistemlerinize entegre ederiz.</p>
                </article>

                <article class="manifesto-card manifesto-card--end">
                    <div class="card-end-content">
                        <h3>Karmaşıklığı bize bırakın.</h3>
                        <p>Siz sadece büyümeye odaklanın.</p>
                    </div>
                </article>

            </div>
        </div>
    </section>

    <!-- CTA SECTION -->
    <section class="about-cta">
        <div class="about-cta-bg" aria-hidden="true"></div>
        <div class="container about-cta-container" data-gsap="fade-up">
            <h2>Hikayenin sonraki bölümünü<br>birlikte yazalım.</h2>
            <div class="cta-actions">
                <a asp-controller="Contact" asp-action="Index" class="btn btn-primary">Projeyi Başlatın</a>
            </div>
        </div>
    </section>
</main>

@section Scripts {
    <script src="~/js/about.js" asp-append-version="true"></script>
}