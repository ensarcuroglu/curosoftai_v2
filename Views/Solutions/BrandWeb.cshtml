@{
    ViewData["Title"] = "Marka ve Web Deneyimi";
    ViewData["BodyClass"] = "studio-minimal-body";
}

@section Styles {
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Plus+Jakarta+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/brandweb.css" asp-append-version="true" />
}

<div class="studio-cursor"></div>

<main id="brandWebMain">

    <section class="studio-hero">
        <div class="studio-container">
            <span class="studio-tag animate-fade">// Marka & Web Deneyimi</span>

            <h1 class="studio-hero__title">
                Fikir ile fonksiyonun <br />
                <span class="editorial-serif">kusursuz</span> birlikteliği.
            </h1>

            <p class="studio-hero__lead">
                Stratejik marka DNA'sını pürüzsüz arayüz tasarımlarına dönüştürüyoruz. Karmaşık kod yığınları yerine, markanızın hikayesini en sade ve ikonik şekilde anlatan kesintisiz dijital deneyimler.
            </p>

            <div class="studio-hero__actions">
                <a href="#dna-journey" class="studio-btn">
                    Yaklaşımımızı İnceleyin
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                </a>
            </div>
        </div>
    </section>

    <section id="dna-journey" class="studio-section journey-section">
        <div class="studio-container">
            <div class="studio-section__header">
                <span class="section-num">[ 01 ]</span>
                <h2 class="section-title">Marka Özyapısından Canlı Web Deneyimine</h2>
                <p class="section-subtitle">Tasarımı sadece bir kabuk olarak değil, markanızın genetiğinden beslenen lineer bir akış ve strateji olarak kurguluyoruz.</p>
            </div>

            <div class="studio-timeline">
                <div class="timeline-row">
                    <div class="timeline-meta"><span>01 / Analiz</span></div>
                    <div class="timeline-content">
                        <h3>Marka DNA Haritası</h3>
                        <p>Şirketinizin vizyonunu, tipografik karakterini ve temel değerlerini çözümlüyor; dijital dünyadaki pazar konumlandırmasının omurgasını oluşturuyoruz.</p>
                    </div>
                </div>

                <div class="timeline-row">
                    <div class="timeline-meta"><span>02 / Yapı</span></div>
                    <div class="timeline-content">
                        <h3>Deneyim Mimarisi (UX)</h3>
                        <p>Ziyaretçinin ihtiyaç duyduğu bilgiye en sezgisel, en zahmetsiz yoldan ulaşmasını sağlayan duru ve empati odaklı kullanıcı yolculukları tasarlıyoruz.</p>
                    </div>
                </div>

                <div class="timeline-row">
                    <div class="timeline-meta"><span>03 / Dil</span></div>
                    <div class="timeline-content">
                        <h3>Tasarım Sistemi & UI</h3>
                        <p>Markanıza özel, oranların ve tipografinin mükemmel uyum içinde olduğu, gelecekte büyüyebilen modüler komponent kütüphaneleri inşa ediyoruz.</p>
                    </div>
                </div>

                <div class="timeline-row">
                    <div class="timeline-meta"><span>04 / Kod</span></div>
                    <div class="timeline-content">
                        <h3>Performans Odaklı Entegrasyon</h3>
                        <p>Sıfır şişirilmiş framework prensibiyle, Google standartlarında en üst düzey hız skorlarına ulaşan, temiz ve saf mimarili kod blokları üretiyoruz.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="studio-section bento-section">
        <div class="studio-container">
            <div class="studio-section__header">
                <span class="section-num">[ 02 ]</span>
                <h2 class="section-title">Neden Çoğu Web Projesi Başarısız Olur?</h2>
                <p class="section-subtitle">Kullanıcıların tahammülü saniyelerle ölçülüyor. Karmaşık tasarımlar ve yavaş altyapılar müşterilerinizi rakiplerinize kaptırır. Biz, bu engelleri saf zanaat kalitesiyle ortadan kaldırıyoruz.</p>
            </div>

            <div class="studio-bento">
                <div class="studio-card bento-8">
                    <div class="card-body">
                        <span class="card-tag">PERFORMANS</span>
                        <h3 class="card-heading">Milisaniyelerle Ölçülen Hız</h3>
                        <p class="card-desc">Hafif ve temiz bir mimariyle optimize edilmiş sistemler kuruyoruz. Hızlı yüklenen sayfalar kullanıcıyı içeride tutar, hemen çıkma oranlarını düşürür ve arama motorlarında (SEO) kalıcı bir güç sağlar.</p>
                    </div>
                    <div class="card-visual">
                        <div class="minimal-speed-indicator">
                            <span class="speed-value">99%</span>
                            <span class="speed-label">Optimal Dağıtım</span>
                        </div>
                    </div>
                </div>

                <div class="studio-card bento-4">
                    <div class="card-body">
                        <span class="card-tag font-meta">TİPOGRAFİ</span>
                        <h3 class="card-heading">Okunabilirlik Sanatı</h3>
                        <p class="card-desc">Gözü yormayan dengeli boşluklar (whitespace) ve editoryal bir font hiyerarşisi kullanarak markanızın dijital olgunluğunu ve premium algısını yükseltiyoruz.</p>
                    </div>
                </div>

                <div class="studio-card bento-4">
                    <div class="card-body">
                        <span class="card-tag">MİMARİ</span>
                        <h3 class="card-heading">Modüler & Ölçeklenebilir</h3>
                        <p class="card-desc">İşiniz büyüdükçe darboğaz yaratmayan esnek komponent yapıları sayesinde gelecekteki tüm ihtiyaçlarınıza organik olarak adapte olabilen sistemler teslim ediyoruz.</p>
                    </div>
                </div>

                <div class="studio-card bento-8">
                    <div class="card-body">
                        <span class="card-tag">DENEYİM</span>
                        <h3 class="card-heading">Kullanıcıyı Anlayan Net Akışlar</h3>
                        <p class="card-desc">Ziyaretçilerinizi labirentlerde yormuyoruz. Davranışsal UX analizleriyle, potansiyel müşteriyi en doğru bilgiye ve doğrudan "iletişim" aksiyonuna götüren pürüzsüz dönüşüm hunileri kurguluyoruz.</p>
                    </div>
                    <div class="card-visual visual-line-art">
                        <div class="minimal-ux-flow-lines">
                            <span class="flow-dot"></span>
                            <span class="flow-line"></span>
                            <span class="flow-dot accent-dot"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="studio-cta-section">
        <div class="studio-container">
            <div class="studio-cta-box">
                <div class="cta-content">
                    <span class="cta-tag">// Geleceği Kurgulamak</span>
                    <h2 class="cta-title">Vizyonunuzu dijital dünyada <br /><span class="editorial-serif text-muted-inline">kalıcı bir ize</span> dönüştürelim.</h2>
                    <p class="cta-desc">İşinizi bir sonraki seviyeye taşıyacak, dönüşüm odaklı ve modern dijital deneyim merkezini birlikte inşa edelim. İlk adımı atmak çok kolay.</p>

                    <a class="studio-btn btn-dark" asp-controller="Contact" asp-action="Index">
                        Projeyi Başlatın
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </a>
                </div>

                <div class="cta-perks">
                    <div class="perk-item">
                        <h4>Ücretsiz Analiz</h4>
                        <p>Mevcut web sitenizin performans ve UX eksiklerini raporluyoruz.</p>
                    </div>
                    <div class="perk-item">
                        <h4>Hızlı Teknik Dönüş</h4>
                        <p>Taleplerinize 24 saat içerisinde zanaat odaklı teknik yanıt üretiyoruz.</p>
                    </div>
                    <div class="perk-item">
                        <h4>Premium Teslimat</h4>
                        <p>Tasarım sisteminden kod mimarisine kadar en ince ayrıntısı düşünülmüş bir ekosistem.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

</main>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.13.2/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.13.2/ScrollTrigger.min.js"></script>
    <script src="~/js/brandweb.js" asp-append-version="true" defer></script>
}