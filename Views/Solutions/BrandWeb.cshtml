@{
    ViewData["Title"] = "Marka ve Web Deneyimi";
    /* Gerekirse layout'taki body class'ını tetiklemek için */
    ViewData["BodyClass"] = "solution-detail-body";
}

@section Styles {
    <link rel="stylesheet" href="~/css/brandweb.css" asp-append-version="true" />
}

<div class="brand-web-page">
    <div class="hero-glow"></div>
    <div class="hero-grain"></div>

    <div class="container">

        <header class="solution-hero fade-up">
            <span class="section-tag">Marka & Web Deneyimi</span>

            <h1 class="hero-title">
                Fikir ile fonksiyonun <br />
                <span class="highlight-serif">kusursuz birlikteliği.</span>
            </h1>

            <p class="hero-lead">
                Stratejik marka DNA'sını pürüzsüz arayüz tasarımlarına dönüştürüyoruz. Karmaşık kod yığınları yerine, markanızın hikayesini milisaniyeler içinde anlatan kesintisiz dijital deneyimler.
            </p>

            <div class="stats-row fade-up">
                <div class="stat-item">
                    <h4>%99+</h4>
                    <span>Performans Skoru</span>
                </div>
                <div class="stat-item">
                    <h4>3x</h4>
                    <span>Etkileşim Artışı</span>
                </div>
                <div class="stat-item">
                    <h4>0</h4>
                    <span>Şişirilmiş Kod</span>
                </div>
            </div>
        </header>

        <section class="challenge-section fade-up">
            <h2 class="section-title">Sıradanlık Markanızı Görünmez Kılar</h2>
            <p class="section-subtitle">Kullanıcıların tahammülü saniyelerle değil, milisaniyelerle ölçülüyor.</p>

            <div class="content-grid">
                <div class="glass-box light-glass">
                    <div class="box-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><line x1="15" y1="9" x2="9" y2="15" /><line x1="9" y1="9" x2="15" y2="15" /></svg>
                    </div>
                    <h3>Şablonlara Sıkışmış Kimlikler</h3>
                    <p>Standart temalar ve hantal altyapılar, kullanıcının markanızla kuracağı bağı anında koparır. Rakiplerinizin arasından sıyrılmak için özgünlüğe ihtiyacınız var.</p>
                </div>

                <div class="glass-box active-glass">
                    <div class="box-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2" /><polyline points="2 17 12 22 22 17" /><polyline points="2 12 12 17 22 12" /></svg>
                    </div>
                    <h3>Sıfırıncı Saniye Etkisi</h3>
                    <p>Markanıza özel, editoryal tipografi ve modüler modern mimari (Headless/API-first) ile optimize edilmiş sistemler, ziyaretçiyi ilk saniyede yakalar.</p>
                </div>
            </div>
        </section>

        <section class="use-cases-section fade-up">
            <h2 class="section-title">Ekranın Arkasındaki Mimari</h2>

            <div class="uc-list">
                <div class="uc-item">
                    <div class="uc-number">01</div>
                    <div class="uc-content">
                        <h3>Marka DNA'sı ve Strateji</h3>
                        <p>Şirketinizin vizyonunu, tipografik karakterini ve temel değerlerini çözümlüyor; dijital dünyadaki pazar konumlandırmasının omurgasını oluşturuyoruz.</p>
                        <div class="uc-tags">
                            <span class="tag">Brand Strategy</span>
                            <span class="tag">Identity</span>
                        </div>
                    </div>
                </div>

                <div class="uc-item">
                    <div class="uc-number">02</div>
                    <div class="uc-content">
                        <h3>Deneyim Mimarisi (UX/UI)</h3>
                        <p>Ziyaretçinin ihtiyaç duyduğu bilgiye en sezgisel yoldan ulaşmasını sağlayan empati odaklı akışlar ve modüler komponent kütüphaneleri inşa ediyoruz.</p>
                        <div class="uc-tags">
                            <span class="tag">UX Flow</span>
                            <span class="tag">Design Systems</span>
                        </div>
                    </div>
                </div>

                <div class="uc-item">
                    <div class="uc-number">03</div>
                    <div class="uc-content">
                        <h3>Performans Odaklı Geliştirme</h3>
                        <p>Sıfır framework şişkinliği prensibiyle, Google standartlarında en üst düzey hız skorlarına ulaşan, temiz ve saf mimarili kod blokları üretiyoruz.</p>
                        <div class="uc-tags">
                            <span class="tag">Headless</span>
                            <span class="tag">Clean Code</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="industry-cta fade-up">
            <div class="web-cta-wrapper">
                <div class="cta-glow-bg"></div>

                <div class="web-content-row">
                    <div class="web-text-col">
                        <div class="creative-badge">
                            <span class="cursor-icon">✨</span>
                            <span>Dijital Zanaat</span>
                        </div>
                        <h2 class="cta-heading">Dijital Dünyada <br> <span class="highlight-serif" style="color: var(--bg-primary);">İz Bırakın.</span></h2>
                        <p class="cta-desc">
                            İşinizi bir sonraki seviyeye taşıyacak, dönüşüm odaklı ve modern dijital deneyim merkezini birlikte inşa edelim.
                        </p>
                        <a asp-controller="Contact" asp-action="Index" class="btn btn-primary cta-action-btn">
                            Projeyi Başlatın
                        </a>
                    </div>

                    <div class="web-visual-col">
                        <div class="glass-browser">
                            <div class="browser-header">
                                <div class="mac-dots">
                                    <span></span><span></span><span></span>
                                </div>
                                <div class="url-bar">curosoftai.com/gelecek</div>
                            </div>
                            <div class="browser-body">
                                <div class="skeleton-hero"></div>
                                <div class="skeleton-cards">
                                    <div class="s-card"></div>
                                    <div class="s-card delay"></div>
                                </div>
                                <div class="floating-cursor">
                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="#E8E2D8" stroke="#2A2420" stroke-width="1.5"><polygon points="3 3 10.5 21 13.5 13.5 21 10.5 3 3"></polygon></svg>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

    </div>
</div>

@section Scripts {
    <script src="~/js/brandweb.js" asp-append-version="true" defer></script>
}