@{
    ViewData["Title"] = "Çözümler";
    ViewData["BodyClass"] = "solutions-page-body";
}

@section Styles {
    <link rel="stylesheet" href="~/css/solutions.css" asp-append-version="true" />
}

<div class="solutions-page">
    <section class="sol-hero" aria-labelledby="solutionsHeading">
        <div class="sol-container sol-hero__layout">
            <div class="sol-hero__copy" data-sol-anim="hero">
                <span class="sol-kicker">
                    <span class="sol-kicker__dot" aria-hidden="true"></span>
                    Çözüm merkezi
                </span>

                <h1 id="solutionsHeading" class="sol-hero__title">
                    İşletmenizin kritik süreçleri için ölçülebilir dijital çözümler.
                </h1>

                <p class="sol-hero__lead">
                    Web, yazılım, otomasyon ve yapay zeka uzmanlığımızı; satış, operasyon,
                    müşteri deneyimi ve karar destek süreçlerinde somut fayda üreten sistemlere dönüştürüyoruz.
                </p>

                <div class="sol-hero__actions">
                    <a class="sol-btn sol-btn--primary" asp-controller="AiSolutions" asp-action="Index">
                        AI çözümlerini incele
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M5 12h14M13 5l7 7-7 7" />
                        </svg>
                    </a>
                    <a class="sol-btn sol-btn--secondary" asp-controller="Contact" asp-action="Index">
                        İhtiyacınızı konuşalım
                    </a>
                </div>
            </div>

            <div class="sol-hero__visual" data-sol-anim="visual" aria-label="Dijital çözüm arayüzleri">
                <img class="sol-visual__image sol-visual__image--main" src="~/images/solutions/operasyonel-yazilim-sistemleri.jpg" alt="Operasyonel yazılım sistemi arayüzü" />
                <img class="sol-visual__image sol-visual__image--small sol-visual__image--top" src="~/images/solutions/ai-cozumleri.jpg" alt="AI destekli analiz ve karar destek arayüzü" />
                <img class="sol-visual__image sol-visual__image--small sol-visual__image--bottom" src="~/images/solutions/marka-web-deneyimi.jpg" alt="Marka ve web deneyimi arayüzü" />
            </div>
        </div>
    </section>

    <section class="sol-section" aria-labelledby="solutionGroupsHeading">
        <div class="sol-container">
            <header class="sol-section__header" data-sol-anim="fade">
                <span class="sol-section__eyebrow">Çözüm alanları</span>
                <h2 id="solutionGroupsHeading" class="sol-section__title">İhtiyacınıza göre şekillenen dijital sistemler.</h2>
                <p class="sol-section__desc">
                    Her çözüm alanı, işletmenizin gerçek bir darboğazını azaltmak ve günlük operasyonu
                    daha hızlı, izlenebilir ve yönetilebilir hale getirmek için tasarlanır.
                </p>
            </header>

            <div class="sol-grid" aria-label="Çözüm alanları">
                <article class="sol-card sol-card--featured" data-sol-anim="card">
                    <a class="sol-card__link" asp-controller="AiSolutions" asp-action="Index" aria-label="AI çözümleri detaylarına git"></a>
                    <div class="sol-card__media">
                        <img src="~/images/solutions/ai-cozumleri.jpg" alt="AI destekli analiz ve karar destek arayüzü" />
                    </div>
                    <div class="sol-card__body">
                        <div class="sol-card__meta">
                            <span class="sol-card__num">01</span>
                            <span class="sol-card__pill sol-card__pill--live">Yapay Zeka</span>
                        </div>
                        <h3 class="sol-card__title">AI Çözümleri</h3>
                        <p class="sol-card__text">
                            Kurumsal bilginizi daha erişilebilir hale getiren; firma asistanı, doküman
                            yorumlama, kaynaklı yanıt üretimi ve doğal dilde sorgulama çözümleri.
                        </p>
                        <span class="sol-card__cta">
                            Detayları incele
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M5 12h14M13 5l7 7-7 7" />
                            </svg>
                        </span>
                    </div>
                </article>

                <article class="sol-card" data-sol-anim="card">
                    <a class="sol-card__link" asp-controller="Solutions" asp-action="BrandWeb" aria-label="Marka ve web deneyimi çözümlerini incele"></a>
                    <div class="sol-card__media">
                        <img src="~/images/solutions/marka-web-deneyimi.jpg" alt="Marka ve kurumsal web deneyimi arayüzü" />
                    </div>
                    <div class="sol-card__body">
                        <div class="sol-card__meta">
                            <span class="sol-card__num">02</span>
                            <span class="sol-card__pill">Web</span>
                        </div>
                        <h3 class="sol-card__title">Marka ve Web Deneyimi</h3>
                        <p class="sol-card__text">
                            Firmanızın güvenini ve profesyonel duruşunu yansıtan; hızlı, erişilebilir,
                            mobil uyumlu ve yönetilebilir web deneyimleri.
                        </p>
                        <span class="sol-card__cta">Hizmetleri incele</span>
                    </div>
                </article>

                <article class="sol-card" data-sol-anim="card">
                    <a class="sol-card__link" asp-controller="Solutions" asp-action="OperationalSoftware" aria-label="Operasyonel yazılım sistemlerini incele"></a>
                    <div class="sol-card__media">
                        <img src="~/images/solutions/operasyonel-yazilim-sistemleri.jpg" alt="Operasyonel yazılım paneli arayüzü" />
                    </div>
                    <div class="sol-card__body">
                        <div class="sol-card__meta">
                            <span class="sol-card__num">03</span>
                            <span class="sol-card__pill">Yazılım</span>
                        </div>
                        <h3 class="sol-card__title">Operasyonel Yazılım Sistemleri</h3>
                        <p class="sol-card__text">
                            Ekiplerinizi, verilerinizi ve günlük iş akışlarınızı tek merkezde buluşturan
                            panel, portal ve takip sistemleri.
                        </p>
                        <ul class="sol-card__tags" aria-label="Operasyonel yazılım kapsamları">
                            <li>Panel</li>
                            <li>API</li>
                            <li>Raporlama</li>
                        </ul>
                    </div>
                </article>

                <article class="sol-card" data-sol-anim="card">
                    <a class="sol-card__link" asp-controller="Contact" asp-action="Index" aria-label="Süreç otomasyonu için iletişime geç"></a>
                    <div class="sol-card__media">
                        <img src="~/images/solutions/surec-otomasyonu.jpg" alt="Süreç otomasyonu ve iş akışı arayüzü" />
                    </div>
                    <div class="sol-card__body">
                        <div class="sol-card__meta">
                            <span class="sol-card__num">04</span>
                            <span class="sol-card__pill">Otomasyon</span>
                        </div>
                        <h3 class="sol-card__title">Akıllı Süreç Otomasyonu</h3>
                        <p class="sol-card__text">
                            Tekrarlayan işlemleri, onay akışlarını ve operasyonel kontrolleri daha hızlı,
                            tutarlı ve ölçülebilir hale getiren otomasyon yapıları.
                        </p>
                        <span class="sol-card__cta">Kapsamı konuşalım</span>
                    </div>
                </article>

                <article class="sol-card sol-card--quiet" data-sol-anim="card">
                    <a class="sol-card__link" asp-controller="Contact" asp-action="Index" aria-label="Veri ve karar destek çözümü için iletişime geç"></a>
                    <div class="sol-card__media">
                        <img src="~/images/solutions/veri-karar-destek.jpg" alt="Veri ve karar destek dashboard arayüzü" />
                    </div>
                    <div class="sol-card__body">
                        <div class="sol-card__meta">
                            <span class="sol-card__num">05</span>
                            <span class="sol-card__pill">Veri</span>
                        </div>
                        <h3 class="sol-card__title">Veri ve Karar Destek</h3>
                        <p class="sol-card__text">
                            Kritik göstergeleri görünür kılan, departmanlar arası bilgi akışını sadeleştiren
                            dashboard ve raporlama çözümleri.
                        </p>
                        <ul class="sol-card__tags" aria-label="Veri ve karar destek kapsamları">
                            <li>KPI</li>
                            <li>Dashboard</li>
                            <li>Analitik</li>
                        </ul>
                    </div>
                </article>

                <article class="sol-card sol-card--quiet" data-sol-anim="card">
                    <a class="sol-card__link" asp-controller="Contact" asp-action="Index" aria-label="E-ticaret ve müşteri portalı için iletişime geç"></a>
                    <div class="sol-card__media">
                        <img src="~/images/solutions/eticaret-musteri-portali.jpg" alt="E-ticaret ve müşteri portalı arayüzü" />
                    </div>
                    <div class="sol-card__body">
                        <div class="sol-card__meta">
                            <span class="sol-card__num">06</span>
                            <span class="sol-card__pill">Portal</span>
                        </div>
                        <h3 class="sol-card__title">E-Ticaret ve Müşteri Portalları</h3>
                        <p class="sol-card__text">
                            Sipariş, teklif, destek ve hesap yönetimi süreçlerini müşterileriniz için
                            daha düzenli ve erişilebilir hale getiren web uygulamaları.
                        </p>
                        <ul class="sol-card__tags" aria-label="Portal kapsamları">
                            <li>Teklif</li>
                            <li>Sipariş</li>
                            <li>Destek</li>
                        </ul>
                    </div>
                </article>
            </div>
        </div>
    </section>

    <section class="sol-cta-section" aria-labelledby="solutionsCtaHeading">
        <div class="sol-container">
            <div class="sol-cta" data-sol-anim="fade">
                <div>
                    <span class="sol-section__eyebrow">Sonraki adım</span>
                    <h2 id="solutionsCtaHeading" class="sol-cta__title">Doğru çözüm alanını birlikte netleştirelim.</h2>
                </div>
                <a class="sol-btn sol-btn--primary" asp-controller="Contact" asp-action="Index">
                    İletişime geç
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M5 12h14M13 5l7 7-7 7" />
                    </svg>
                </a>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script src="~/js/solutions.js" asp-append-version="true" defer></script>
}
