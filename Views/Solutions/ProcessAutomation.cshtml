@{
    ViewData["Title"] = "Akıllı Süreç Otomasyonu";
    ViewData["BodyClass"] = "solution-detail-body";
}

@section Styles {
    <link rel="stylesheet" href="~/css/processautomation.css" asp-append-version="true" />
}

<div class="process-auto-page">
    <div class="hero-glow"></div>
    <div class="hero-grain"></div>
    <div class="container">

        <header class="solution-hero fade-up">
            <span class="section-tag">Intelligent Automation</span>

            <h1 class="hero-title">
                Sürekli işleyen <br />
                <span class="highlight-serif">kusursuz bir ritim.</span>
            </h1>

            <p class="hero-lead">
                İnsan potansiyelini tekrarlayan görevlerden kurtarıyoruz. Yapay zeka destekli süreç otomasyonu ile iş akışlarınızı kendi kendini yöneten, hata payı sıfıra inmiş akıllı ekosistemlere dönüştürüyoruz.
            </p>

            <div class="stats-row fade-up">
                <div class="stat-item">
                    <h4>7/24</h4>
                    <span>Kesintisiz Operasyon</span>
                </div>
                <div class="stat-item">
                    <h4>%99</h4>
                    <span>Hata Azalması</span>
                </div>
                <div class="stat-item">
                    <h4>10x</h4>
                    <span>İşlem Hızı Artışı</span>
                </div>
            </div>
        </header>

        <section class="challenge-section fade-up">
            <h2 class="section-title">Manuel İşler Büyümenin Önündeki En Büyük Engeldir</h2>
            <p class="section-subtitle">Zamanınızı operasyonu sürdürmek için değil, işinizi büyütmek için kullanmalısınız.</p>

            <div class="content-grid">
                <div class="glass-box light-glass">
                    <div class="box-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
                    </div>
                    <h3>Zaman ve Kaynak İsrafı</h3>
                    <p>Veri girişi, onay süreçleri ve dosya aktarımları gibi manuel işlemler, ekibinizin enerjisini tüketirken operasyonel maliyetleri gizlice artırır.</p>
                </div>

                <div class="glass-box active-glass">
                    <div class="box-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83" /></svg>
                    </div>
                    <h3>Bilişsel Otomasyon</h3>
                    <p>Yalnızca kural tabanlı değil, karar verebilen yapay zeka ajanları (Cognitive RPA) ile karmaşık senaryoları bile insan müdahalesi olmadan çözümlüyoruz.</p>
                </div>
            </div>
        </section>

        <section class="use-cases-section fade-up">
            <h2 class="section-title">Otonom Mimari Katmanları</h2>

            <div class="uc-list">
                <div class="uc-item">
                    <div class="uc-number">01</div>
                    <div class="uc-content">
                        <h3>Akıllı Belge İşleme (IDP)</h3>
                        <p>Fatura, sözleşme veya formlardaki yapılandırılmamış verileri optik karakter tanıma (OCR) ve doğal dil işleme (NLP) ile okur, anlamlandırır ve sistemlerinize aktarırız.</p>
                        <div class="uc-tags">
                            <span class="tag">AI OCR</span>
                            <span class="tag">Data Extraction</span>
                        </div>
                    </div>
                </div>

                <div class="uc-item">
                    <div class="uc-number">02</div>
                    <div class="uc-content">
                        <h3>Karar Destek ve Yönlendirme</h3>
                        <p>Gelen talepleri, e-postaları veya destek biletlerini duygu durumuna ve içeriğine göre analiz eden botlar; görevleri doğru departmana veya onaya otomatik yönlendirir.</p>
                        <div class="uc-tags">
                            <span class="tag">Smart Routing</span>
                            <span class="tag">NLP Analysis</span>
                        </div>
                    </div>
                </div>

                <div class="uc-item">
                    <div class="uc-number">03</div>
                    <div class="uc-content">
                        <h3>Sistemler Arası Köprü (API & RPA)</h3>
                        <p>Birbiriyle doğrudan entegrasyonu olmayan eski (legacy) sistemleriniz ile modern bulut uygulamalarınız arasında güvenli ve yüksek hızlı veri otobanları inşa ediyoruz.</p>
                        <div class="uc-tags">
                            <span class="tag">Legacy Modernization</span>
                            <span class="tag">API Orchestration</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="industry-cta fade-up">
            <div class="auto-cta-wrapper">
                <div class="cta-mesh-bg"></div>

                <div class="auto-content-row">
                    <div class="auto-text-col">
                        <div class="status-badge">
                            <span class="live-dot"></span>
                            <span>Otomasyon Aktif</span>
                        </div>
                        <h2 class="cta-heading">Sıfır Sürtünme, <br> <span class="highlight-serif" style="color: var(--bg-primary);">Maksimum İvme.</span></h2>
                        <p class="cta-desc">
                            İşletmenizin sinir ağını dijitalleştirin. Otonom iş akışlarıyla verimliliğin sınırlarını baştan çizelim.
                        </p>
                        <a asp-controller="Contact" asp-action="Index" class="btn btn-primary cta-action-btn">
                            Süreç Analizi Talep Edin
                        </a>
                    </div>

                    <div class="auto-visual-col">
                        <div class="workflow-ui">
                            <div class="workflow-header">PROCESS_PIPELINE</div>
                            <div class="workflow-canvas">
                                <!-- Node 1 -->
                                <div class="node-item" id="node1">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12" /></svg>
                                </div>
                                <div class="flow-path"><div class="flow-pulse"></div></div>

                                <!-- Node 2 -->
                                <div class="node-item" id="node2">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z" /></svg>
                                </div>
                                <div class="flow-path"><div class="flow-pulse delay-1"></div></div>

                                <!-- Node 3 -->
                                <div class="node-item final-node" id="node3">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>
                                </div>
                            </div>
                            <div class="workflow-logs">
                                <div class="log-line">Data extracted successfully.</div>
                                <div class="log-line">AI validation: PASS.</div>
                                <div class="log-line">Pushed to ERP system.</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

    </div>
</div>

@section Scripts {
    <script src="~/js/processautomation.js" asp-append-version="true" defer></script>
}