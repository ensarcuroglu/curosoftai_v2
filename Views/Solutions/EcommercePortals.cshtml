@{
    ViewData["Title"] = "E-Ticaret ve Müşteri Portalları";
    ViewData["BodyClass"] = "solution-detail-body";
}

@section Styles {
    <link rel="stylesheet" href="~/css/ecommerceportals.css" asp-append-version="true" />
}

<div class="ecommerce-page">
    <div class="hero-glow"></div>
    <div class="hero-grain"></div>
    <div class="container">

        <header class="solution-hero fade-up">
            <span class="section-tag">Digital Commerce & Portals</span>

            <h1 class="hero-title">
                Sınırları kaldıran <br />
                <span class="highlight-serif">kesintisiz deneyimler.</span>
            </h1>

            <p class="hero-lead">
                Müşterilerinizle aranızdaki tüm engelleri kaldırıyoruz. Yüksek dönüşüm sağlayan modern e-ticaret altyapıları ve operasyonel yükünüzü hafifleten self-servis B2B müşteri portalları inşa ediyoruz.
            </p>

            <div class="stats-row fade-up">
                <div class="stat-item">
                    <h4>+45%</h4>
                    <span>Dönüşüm Artışı</span>
                </div>
                <div class="stat-item">
                    <h4>7/24</h4>
                    <span>Self-Servis Erişim</span>
                </div>
                <div class="stat-item">
                    <h4>Sıfır</h4>
                    <span>Güvenlik Açığı</span>
                </div>
            </div>
        </header>

        <section class="challenge-section fade-up">
            <h2 class="section-title">Hazır Şablonlar Sizi Sıradanlaştırır</h2>
            <p class="section-subtitle">Müşteri sadakati, ancak kusursuz çalışan özgün bir deneyimle kazanılır.</p>

            <div class="content-grid">
                <div class="glass-box light-glass">
                    <div class="box-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
                    </div>
                    <h3>Hantal ve Terk Edilen Sepetler</h3>
                    <p>Yavaş yüklenen sayfalar ve karmaşık ödeme adımları, müşteriyi rakibe iter. Biz milisaniyeler içinde tepki veren, pürüzsüz akışlar tasarlıyoruz.</p>
                </div>

                <div class="glass-box active-glass">
                    <div class="box-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                    </div>
                    <h3>Kopuk B2B İletişimi</h3>
                    <p>Müşterilerinizin fatura, teklif veya sipariş takibi için sürekli size ulaşması gerekmemeli. Operasyonel yükü şeffaf portallarla sıfırlıyoruz.</p>
                </div>
            </div>
        </section>

        <section class="use-cases-section fade-up">
            <h2 class="section-title">Dijital Ticaretin Mimari Katmanları</h2>

            <div class="uc-list">
                <div class="uc-item">
                    <div class="uc-number">01</div>
                    <div class="uc-content">
                        <h3>Headless E-Ticaret Platformları</h3>
                        <p>Önyüzü (Frontend) arkaplandan (Backend) ayırarak, marka kimliğinize tamamen özgü, ışık hızında çalışan ve sınırsız ölçeklenebilen mağazalar oluşturuyoruz.</p>
                        <div class="uc-tags">
                            <span class="tag">Headless Commerce</span>
                            <span class="tag">Omnichannel</span>
                        </div>
                    </div>
                </div>

                <div class="uc-item">
                    <div class="uc-number">02</div>
                    <div class="uc-content">
                        <h3>B2B Self-Servis Portallar</h3>
                        <p>Kurumsal müşterilerinizin kendi sözleşmelerini, özel fiyatlandırmalarını ve geçmiş siparişlerini yönetebildiği güvenli müşteri merkezleri kuruyoruz.</p>
                        <div class="uc-tags">
                            <span class="tag">Client Portal</span>
                            <span class="tag">Self-Service</span>
                        </div>
                    </div>
                </div>

                <div class="uc-item">
                    <div class="uc-number">03</div>
                    <div class="uc-content">
                        <h3>Derin Entegrasyon (ERP & Ödeme)</h3>
                        <p>Muhasebe, stok (ERP), CRM ve global ödeme geçitleriyle çift yönlü, kusursuz ve anlık veri senkronizasyonu sağlayan altyapılar geliştiriyoruz.</p>
                        <div class="uc-tags">
                            <span class="tag">ERP Sync</span>
                            <span class="tag">Payment Gateways</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="industry-cta fade-up">
            <div class="ecom-cta-wrapper">
                <div class="ecom-aura-bg"></div>

                <div class="ecom-content-row">
                    <div class="ecom-text-col">
                        <div class="commerce-badge">
                            <span class="secure-icon"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg></span>
                            <span>256-bit Güvenli Altyapı</span>
                        </div>
                        <h2 class="cta-heading">Satışları ve Bağlılığı <br> <span class="highlight-serif" style="color: var(--bg-primary);">Zirveye Taşıyın.</span></h2>
                        <p class="cta-desc">
                            İşletmenizin dijital vitrinini ve müşteri yönetim merkezini dünya standartlarında baştan yaratalım.
                        </p>
                        <a asp-controller="Contact" asp-action="Index" class="btn btn-primary cta-action-btn">
                            Mağazayı Başlatın
                        </a>
                    </div>

                    <div class="ecom-visual-col">
                        <div class="portal-ui">
                            <div class="ui-header">
                                <div class="ui-title">SECURE_CHECKOUT</div>
                                <div class="ui-user"><div class="avatar"></div></div>
                            </div>

                            <div class="ui-body">
                                <div class="cart-items">
                                    <div class="cart-item">
                                        <div class="item-img"></div>
                                        <div class="item-details">
                                            <div class="item-line title"></div>
                                            <div class="item-line subtitle"></div>
                                        </div>
                                    </div>
                                    <div class="cart-item">
                                        <div class="item-img"></div>
                                        <div class="item-details">
                                            <div class="item-line title" style="width: 70%;"></div>
                                            <div class="item-line subtitle" style="width: 40%;"></div>
                                        </div>
                                    </div>
                                </div>

                                <div class="cart-divider"></div>

                                <div class="checkout-footer">
                                    <div class="total-row">
                                        <span>TOTAL</span>
                                        <span class="amount">₺ 42.500</span>
                                    </div>
                                    <div class="checkout-btn">
                                        <span class="btn-shine"></span>
                                        Onayla ve Öde
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

    </div>
</div>

@section Scripts {
    <script src="~/js/ecommerceportals.js" asp-append-version="true" defer></script>
}