@{
    ViewData["Title"] = "Operasyonel Yazılım Sistemleri";
    ViewData["BodyClass"] = "solution-detail-body";
}

@section Styles {
    <link rel="stylesheet" href="~/css/operationalsoftware.css" asp-append-version="true" />
}

<div class="op-software-page">
    <div class="hero-glow"></div>
    <div class="hero-grain"></div>
    <div class="container">

        <header class="solution-hero fade-up">
            <span class="section-tag">Enterprise Solutions</span>
            <h1 class="hero-title">
                Karmaşıklığı yöneten <br />
                <span class="highlight-serif">akıllı altyapılar.</span>
            </h1>
            <p class="hero-lead">
                İş süreçlerinizi manuel hatalardan arındırıyor, veriyi karara dönüştüren uçtan uca operasyonel ekosistemler kuruyoruz. Hız sadece bir özellik değil, sistemlerimizin omurgasıdır.
            </p>

            <div class="stats-row fade-up">
                <div class="stat-item">
                    <h4>99.9%</h4>
                    <span>Uptime Garantisi</span>
                </div>
                <div class="stat-item">
                    <h4>-40%</h4>
                    <span>Operasyonel Maliyet</span>
                </div>
                <div class="stat-item">
                    <h4>&lt;100ms</h4>
                    <span>Veri İşleme Hızı</span>
                </div>
            </div>
        </header>

        <section class="challenge-section fade-up">
            <h2 class="section-title">Hantal Sistemler Büyümenizi Durdurur</h2>
            <p class="section-subtitle">Geleceğin operasyonları, dünün teknolojileriyle yönetilemez.</p>

            <div class="content-grid">
                <div class="glass-box light-glass">
                    <div class="box-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>
                    </div>
                    <h3>Veri Adacıkları ve Kopukluk</h3>
                    <p>Farklı birimlerin birbiriyle konuşmayan yazılımları, operasyonel körlük yaratır. Biz, tüm veri akışını tek bir merkezi sinir sistemine bağlıyoruz.</p>
                </div>

                <div class="glass-box active-glass">
                    <div class="box-icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="8" rx="2" ry="2" /><rect x="2" y="14" width="20" height="8" rx="2" ry="2" /><line x1="6" y1="6" x2="6.01" y2="6" /><line x1="6" y1="18" x2="6.01" y2="18" /></svg>
                    </div>
                    <h3>Ölçeklenebilir Mikro-Mimari</h3>
                    <p>İşiniz büyüdükçe hantallaşmayan, talebe göre esneyen mikroservis tabanlı Cloud-Native çözümlerle altyapınızı geleceğe hazırlıyoruz.</p>
                </div>
            </div>
        </section>

        <section class="use-cases-section fade-up">
            <h2 class="section-title">Operasyonel Mükemmellik Katmanları</h2>

            <div class="uc-list">
                <div class="uc-item">
                    <div class="uc-number">01</div>
                    <div class="uc-content">
                        <h3>Süreç Madenciliği & Analiz</h3>
                        <p>Mevcut iş akışlarınızdaki darboğazları tespit ediyor, dijital ikiz üzerinden optimizasyon simülasyonları gerçekleştiriyoruz.</p>
                        <div class="uc-tags">
                            <span class="tag">Process Mining</span>
                            <span class="tag">Workflow Audit</span>
                        </div>
                    </div>
                </div>

                <div class="uc-item">
                    <div class="uc-number">02</div>
                    <div class="uc-content">
                        <h3>Özel ERP & CRM Entegrasyonu</h3>
                        <p>Hazır paketlerin kısıtlamalarından kurtulun. Tamamen sizin iş yapış biçiminize göre terzi usulü dikilmiş yönetim panelleri.</p>
                        <div class="uc-tags">
                            <span class="tag">Custom ERP</span>
                            <span class="tag">API Integration</span>
                        </div>
                    </div>
                </div>

                <div class="uc-item">
                    <div class="uc-number">03</div>
                    <div class="uc-content">
                        <h3>Otomasyon & Yapay Zeka (RPA)</h3>
                        <p>Tekrarlayan görevleri akıllı botlara devredin. İnsan kaynağınızı sadece stratejik karar gerektiren noktalarda kullanın.</p>
                        <div class="uc-tags">
                            <span class="tag">RPA</span>
                            <span class="tag">AI Engine</span>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="industry-cta fade-up">
            <div class="op-cta-wrapper">
                <div class="cta-grid-bg"></div>

                <div class="op-content-row">
                    <div class="op-text-col">
                        <div class="tech-badge">
                            <span class="pulse-dot"></span>
                            <span>Sistemler Aktif</span>
                        </div>
                        <h2 class="cta-heading">Verimliliği <br> <span class="highlight-serif" style="color: var(--bg-primary);">Yeniden Tanımlayın.</span></h2>
                        <p class="cta-desc">
                            Karmaşık süreçlerinizi sadeleştirmek ve dijital dönüşümünüzü stabilize etmek için hazırız.
                        </p>
                        <a asp-controller="Contact" asp-action="Index" class="btn btn-primary cta-action-btn">
                            Sistemi Başlatın
                        </a>
                    </div>

                    <div class="op-visual-col">
                        <div class="data-dashboard-ui">
                            <div class="ui-header">
                                <div class="ui-title">SYSTEM_MONITOR_V2</div>
                                <div class="ui-status">LIVE</div>
                            </div>
                            <div class="ui-body">
                                <div class="chart-skeleton">
                                    <div class="bar" style="height: 40%"></div>
                                    <div class="bar" style="height: 70%"></div>
                                    <div class="bar" style="height: 50%"></div>
                                    <div class="bar" style="height: 90%"></div>
                                    <div class="bar" style="height: 60%"></div>
                                </div>
                                <div class="node-map">
                                    <span class="node"></span>
                                    <span class="line"></span>
                                    <span class="node active"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <script src="~/js/operationalsoftware.js" asp-append-version="true" defer></script>
}