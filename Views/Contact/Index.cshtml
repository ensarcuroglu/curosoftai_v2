@{
    ViewData["Title"] = "İletişim | Curosoftai";
}

@section Styles {
    <link rel="stylesheet" href="~/css/contact.css" asp-append-version="true" />
}

<main class="contact-page">
    <div class="contact-ambient" aria-hidden="true">
        <div class="ambient-glow orb-1"></div>
        <div class="ambient-glow orb-2"></div>
    </div>

    <div class="container contact-container">
        <div class="contact-grid">

            <section class="contact-info" aria-labelledby="contactTitle">
                <header class="contact-header" data-gsap="fade-up">
                    <div class="status-pill">
                        <span class="status-dot"></span>
                        <span class="status-text">Studio 2026 · Yeni Projelere Açık</span>
                    </div>
                    <h1 id="contactTitle" class="contact-title">
                        Fikrinizi <em class="title-em">koda dökme</em> zamanı.
                    </h1>
                    <p class="contact-lead">
                        Dijital sınırları kaldırıyoruz. Vizyonunuzu bizimle paylaşın; estetik, performans ve yapay zeka ile geleceği birlikte inşa edelim.
                    </p>
                </header>

                <div class="contact-meta" data-gsap="fade-up" data-delay="0.1">
                    <div class="meta-item">
                        <span class="meta-label">Direkt Hat</span>
                        <a href="mailto:hello@curosoftai.com" class="meta-link meta-link--hero">hello@curosoftai.com</a>
                    </div>

                    <div class="meta-row">
                        <div class="meta-item">
                            <span class="meta-label">Lokasyon</span>
                            <span class="meta-text">Remote & Worldwide</span>
                        </div>
                        <div class="meta-item">
                            <span class="meta-label">Yerel Saat (GMT+3)</span>
                            <span class="meta-text" id="liveLocalTime">Yükleniyor...</span>
                        </div>
                    </div>

                    <div class="meta-item">
                        <span class="meta-label">Dijital Varlıklar</span>
                        <div class="social-links">
                            <a href="#" target="_blank" rel="noopener">LinkedIn ↗</a>
                            <a href="#" target="_blank" rel="noopener">GitHub ↗</a>
                            <a href="#" target="_blank" rel="noopener">X (Twitter) ↗</a>
                        </div>
                    </div>
                </div>

                <div class="contact-process" data-gsap="fade-up" data-delay="0.2">
                    <ul class="process-list">
                        <li>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                            <span>24 saat içinde dönüş yaparız.</span>
                        </li>
                        <li>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                            <span>Gizlilik (NDA) çerçevesinde fikirlerinizi koruruz.</span>
                        </li>
                    </ul>
                </div>

                <div class="contact-alternative" data-gsap="fade-up" data-delay="0.3">
                    <p>
                        Form doldurmak istemiyor musunuz? <br>
                        <a href="#" target="_blank" class="meeting-link">Takvimimizden 15 dakikalık bir tanışma planlayın.</a>
                    </p>
                </div>
            </section>

            <section class="contact-form-wrapper" data-gsap="form-reveal">
                <div class="form-panel">
                    <form id="contactForm" class="minimal-form" novalidate>

                        <div class="form-row">
                            <div class="input-group">
                                <input type="text" id="FullName" name="FullName" class="form-input" placeholder=" " required />
                                <label for="FullName" class="form-label">Adınız Soyadınız</label>
                                <span class="error-text">Lütfen adınızı girin.</span>
                            </div>
                        </div>

                        <div class="form-row split-row">
                            <div class="input-group">
                                <input type="email" id="Email" name="Email" class="form-input" placeholder=" " required />
                                <label for="Email" class="form-label">E-posta Adresiniz</label>
                                <span class="error-text">Geçerli bir e-posta girin.</span>
                            </div>
                            <div class="input-group">
                                <input type="text" id="Company" name="Company" class="form-input" placeholder=" " />
                                <label for="Company" class="form-label">Şirket / Marka</label>
                            </div>
                        </div>

                        <div class="form-row form-row--chips">
                            <span class="form-group-label">Hangi alanda çözüm arıyorsunuz?</span>
                            <div class="chip-group" role="radiogroup">
                                <label class="chip-item">
                                    <input type="radio" name="Service" value="Kurumsal Web" checked />
                                    <span class="chip-content">Kurumsal Web</span>
                                </label>
                                <label class="chip-item">
                                    <input type="radio" name="Service" value="Özel Yazılım" />
                                    <span class="chip-content">Özel Yazılım</span>
                                </label>
                                <label class="chip-item">
                                    <input type="radio" name="Service" value="Yapay Zeka" />
                                    <span class="chip-content">Yapay Zeka & AI</span>
                                </label>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="input-group">
                                <textarea id="Message" name="Message" class="form-input form-textarea" placeholder=" " rows="1" required></textarea>
                                <label for="Message" class="form-label">Projenizden kısaca bahsedin...</label>
                                <span class="error-text">Lütfen mesajınızı yazın.</span>
                            </div>
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="btn-submit w-100">
                                <span class="btn-text">Talebi İlet</span>
                            </button>
                        </div>

                        <div class="form-status" id="formStatus" aria-hidden="true" role="alert">
                            <div class="status-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            </div>
                            <div class="status-content">
                                <strong>Mesajınız Ulaştı</strong>
                                <span>Size en kısa sürede dönüş yapacağız.</span>
                            </div>
                        </div>

                    </form>
                </div>
            </section>

        </div>
    </div>
</main>

@section Scripts {
    <script src="~/js/contact.js" asp-append-version="true"></script>
}