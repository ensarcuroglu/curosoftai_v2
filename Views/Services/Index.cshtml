@{
    ViewData["Title"] = "Hizmetler";
}

@section Styles {
    <link rel="stylesheet" href="~/css/services.css" asp-append-version="true" />
}

<div class="services-page">

    <section class="svc-hero" aria-labelledby="servicesHeroHeading">
        <div class="svc-container svc-hero__layout">
            <div class="svc-hero__copy">
                <div class="svc-eyebrow-pill" data-svc-anim="hero">
                    <span class="svc-eyebrow-pill__dot"></span>
                    <span class="svc-eyebrow-pill__text">Hizmetlerimiz</span>
                </div>

                <h1 id="servicesHeroHeading" class="svc-hero__title" data-svc-anim="hero">
                    Dijital ürün, web ve AI projeleri için
                    <span class="svc-gradient-text">uçtan uca geliştirme hizmetleri.</span>
                </h1>

                <p class="svc-hero__lead" data-svc-anim="hero">
                    Strateji, arayüz, yazılım mimarisi, entegrasyon ve bakım süreçlerini tek bir
                    teslimat düzeninde yönetiyoruz. Amaç sadece yayına çıkmak değil, ölçülebilir,
                    güvenilir ve sürdürülebilir sistemler kurmak.
                </p>

                <div class="svc-hero__actions" data-svc-anim="hero">
                    <a class="svc-btn svc-btn--pill-primary" asp-controller="Contact" asp-action="Index">
                        Projenizi konuşalım
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M5 12h14M13 5l7 7-7 7" />
                        </svg>
                    </a>
                    <a class="svc-btn svc-btn--pill-glass" asp-controller="Project" asp-action="Index">
                        Projeleri incele
                    </a>
                </div>
            </div>

            <aside class="svc-hero-panel" data-svc-anim="hero" aria-label="Ne teslim ediyoruz">
                <div class="svc-hero-panel__top">
                    <span class="svc-hero-panel__label">Ne teslim ediyoruz</span>
                    <span class="svc-hero-panel__status">Uçtan uca</span>
                </div>
                <ul class="svc-hero-panel__list">
                    <li>
                        <span class="svc-hero-panel__check" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20 6 9 17l-5-5" />
                            </svg>
                        </span>
                        <span class="svc-hero-panel__item">
                            <strong>Ölçülebilir kapsam</strong>
                            <em>Net hedef, kullanıcı akışı ve kabul kriteri</em>
                        </span>
                    </li>
                    <li>
                        <span class="svc-hero-panel__check" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20 6 9 17l-5-5" />
                            </svg>
                        </span>
                        <span class="svc-hero-panel__item">
                            <strong>Sürdürülebilir mimari</strong>
                            <em>Büyümeyi engellemeyen kod ve veri yapısı</em>
                        </span>
                    </li>
                    <li>
                        <span class="svc-hero-panel__check" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20 6 9 17l-5-5" />
                            </svg>
                        </span>
                        <span class="svc-hero-panel__item">
                            <strong>Performans ve güven</strong>
                            <em>Hız, erişilebilirlik ve güvenlik dahil</em>
                        </span>
                    </li>
                </ul>
                <div class="svc-hero-panel__proof">
                    <strong>Yayın sonrası sahiplik</strong>
                    <span>Canlı sistem izlenir, bakımı yapılır ve sürekli iyileştirilir.</span>
                </div>
            </aside>
        </div>
    </section>

    <section class="svc-section svc-services" aria-labelledby="servicesPortfolioHeading">
        <div class="svc-container">
            <header class="svc-section__head" data-svc-anim="fade">
                <span class="svc-section__eyebrow">Hizmet portföyü</span>
                <h2 id="servicesPortfolioHeading" class="svc-section__title">
                    Her proje için net kapsam, net çıktı, net sorumluluk.
                </h2>
                <p class="svc-section__desc">
                    Hizmetlerimiz, tekil sayfa tasarımından kurumsal platform geliştirmeye kadar
                    farklı olgunluk seviyelerine uyarlanır. Gereken yerde danışmanlık, gereken yerde
                    tam uygulama ekibi gibi çalışırız.
                </p>
            </header>

            <div class="svc-bento-grid">
                <article class="svc-card svc-card--featured" data-svc-anim="card">
                    <span class="svc-card__watermark">01</span>
                    <div class="svc-card__content-wrapper">
                        <div class="svc-card__info">
                            <div class="svc-card__top">
                                <span class="svc-card__icon-pill" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M4 5h16a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z" />
                                        <path d="M7 9h5M7 13h8M17 9h.01" />
                                    </svg>
                                </span>
                                <span class="svc-card__badge-pill">Temel uzmanlık</span>
                            </div>
                            <h3 class="svc-card__title">Kurumsal web ve dijital deneyim</h3>
                            <p class="svc-card__desc">
                                Marka güvenini artıran, hızlı çalışan, mobil uyumlu ve yönetilebilir
                                kurumsal web siteleri geliştiriyoruz.
                            </p>
                        </div>

                        <div class="svc-card__details">
                            <div>
                                <span class="svc-card__mini-title">Kapsam</span>
                                <ul class="svc-card__list">
                                    <li>Bilgi mimarisi ve sayfa akışı</li>
                                    <li>Responsive arayüz geliştirme</li>
                                    <li>SEO, performans ve erişilebilirlik temelleri</li>
                                    <li>İletişim formları, içerik yapısı ve yönetim ihtiyaçları</li>
                                </ul>
                            </div>
                            <div class="svc-card__outcome">
                                <span>Çıktı</span>
                                <strong>Yayına hazır, ölçümlenebilir kurumsal web deneyimi</strong>
                            </div>
                        </div>
                    </div>
                </article>

                <article class="svc-card" data-svc-anim="card">
                    <span class="svc-card__watermark">02</span>
                    <div class="svc-card__top">
                        <span class="svc-card__icon-pill" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M8 8l-4 4 4 4" />
                                <path d="M16 8l4 4-4 4" />
                                <path d="M13.5 6l-3 12" />
                            </svg>
                        </span>
                    </div>
                    <h3 class="svc-card__title">Özel yazılım geliştirme</h3>
                    <p class="svc-card__desc">
                        İşletmenizin çalışma biçimine uygun panel, portal, raporlama ve takip sistemleri kuruyoruz.
                    </p>
                    <span class="svc-card__mini-title">Odak alanları</span>
                    <ul class="svc-card__list">
                        <li>Operasyon panelleri</li>
                        <li>Müşteri ve bayi portalları</li>
                        <li>Veri akışı ve rol bazlı yetkilendirme</li>
                    </ul>
                </article>

                <article class="svc-card" data-svc-anim="card">
                    <span class="svc-card__watermark">03</span>
                    <div class="svc-card__top">
                        <span class="svc-card__icon-pill" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 3v3M12 18v3M3 12h3M18 12h3" />
                                <rect x="7" y="7" width="10" height="10" rx="2" />
                                <path d="M10 12h4M12 10v4" />
                            </svg>
                        </span>
                    </div>
                    <h3 class="svc-card__title">AI entegrasyonu ve otomasyon</h3>
                    <p class="svc-card__desc">
                        Doküman, web sitesi ve iç süreç verilerini kaynaklı AI akışlarına bağlayan modüller geliştiriyoruz.
                    </p>
                    <span class="svc-card__mini-title">Odak alanları</span>
                    <ul class="svc-card__list">
                        <li>Firma asistanı ve bilgi tabanı</li>
                        <li>Doküman yorumlama</li>
                        <li>Doğal dilde sorgulama ve işlem tetikleme</li>
                    </ul>
                </article>

                <article class="svc-card" data-svc-anim="card">
                    <span class="svc-card__watermark">04</span>
                    <div class="svc-card__top">
                        <span class="svc-card__icon-pill" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M4 7h16M4 12h10M4 17h7" />
                                <path d="M17 14l2 2 3-4" />
                            </svg>
                        </span>
                    </div>
                    <h3 class="svc-card__title">Ürün stratejisi ve teknik danışmanlık</h3>
                    <p class="svc-card__desc">
                        Fikir, MVP veya mevcut sistemler için kapsam, öncelik, teknoloji ve yol haritası netleştiriyoruz.
                    </p>
                    <span class="svc-card__mini-title">Odak alanları</span>
                    <ul class="svc-card__list">
                        <li>Teknik analiz ve kapsam dokümanı</li>
                        <li>MVP önceliklendirme</li>
                        <li>Mimari karar ve risk değerlendirmesi</li>
                    </ul>
                </article>

                <article class="svc-card" data-svc-anim="card">
                    <span class="svc-card__watermark">05</span>
                    <div class="svc-card__top">
                        <span class="svc-card__icon-pill" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 3a7 7 0 0 0-7 7c0 5 7 11 7 11s7-6 7-11a7 7 0 0 0-7-7Z" />
                                <circle cx="12" cy="10" r="2.5" />
                            </svg>
                        </span>
                    </div>
                    <h3 class="svc-card__title">Bakım, izleme ve sürekli iyileştirme</h3>
                    <p class="svc-card__desc">
                        Yayın sonrası sistemin hızlı, güvenli ve güncel kalması için bakım ve geliştirme döngüsü kuruyoruz.
                    </p>
                    <span class="svc-card__mini-title">Odak alanları</span>
                    <ul class="svc-card__list">
                        <li>Performans ve hata izleme</li>
                        <li>İçerik, özellik ve güvenlik güncellemeleri</li>
                        <li>Kademeli ürün geliştirme</li>
                    </ul>
                </article>
            </div>
        </div>
    </section>

    <section class="svc-section svc-standards" aria-labelledby="standardsHeading">
        <div class="svc-container svc-standards__layout">
            <header class="svc-section__head" data-svc-anim="fade">
                <span class="svc-section__eyebrow">Teslimat kalitesi</span>
                <h2 id="standardsHeading" class="svc-section__title">
                    Sadece geliştirmiyoruz, işletilebilir sistem teslim ediyoruz.
                </h2>
            </header>

            <div class="svc-standards__grid">
                <article class="svc-standard" data-svc-anim="card">
                    <span>01</span>
                    <h3>Ölçülebilir kapsam</h3>
                    <p>Her iş net hedef, kullanıcı akışı, teknik kapsam ve kabul kriterleriyle başlar.</p>
                </article>
                <article class="svc-standard" data-svc-anim="card">
                    <span>02</span>
                    <h3>Sürdürülebilir mimari</h3>
                    <p>Kod, entegrasyon ve veri yapıları ileride büyümeyi engellemeyecek şekilde planlanır.</p>
                </article>
                <article class="svc-standard" data-svc-anim="card">
                    <span>03</span>
                    <h3>Performans ve güven</h3>
                    <p>Hız, erişilebilirlik, güvenlik ve mobil deneyim teslimatın parçası olarak ele alınır.</p>
                </article>
                <article class="svc-standard" data-svc-anim="card">
                    <span>04</span>
                    <h3>Yayın sonrası sahiplik</h3>
                    <p>Canlıya alınan sistemler izlenir, iyileştirilir ve yeni ihtiyaçlara göre geliştirilir.</p>
                </article>
            </div>
        </div>
    </section>

    <section class="svc-section svc-process" aria-labelledby="servicesProcessHeading">
        <div class="svc-container">
            <header class="svc-section__head svc-section__head--centered" data-svc-anim="fade">
                <span class="svc-section__eyebrow">Çalışma modeli</span>
                <h2 id="servicesProcessHeading" class="svc-section__title">Profesyonel, şeffaf ve takip edilebilir süreç.</h2>
                <p class="svc-section__desc">
                    Projenin büyüklüğü ne olursa olsun aynı disiplinle ilerleriz: önce problemi netleştirir,
                    sonra kapsamı tasarlar, geliştirir, test eder ve yayına alırız.
                </p>
            </header>

            <div class="svc-steps-wrapper">
                <div class="svc-steps__line" aria-hidden="true">
                    <span class="svc-steps__line-fill"></span>
                </div>

                <div class="svc-steps">
                    <div class="svc-step" data-svc-anim="step">
                        <span class="svc-step__num-pill">01</span>
                        <h3 class="svc-step__title">Keşif</h3>
                        <p class="svc-step__desc">İş hedefi, kullanıcı ihtiyacı, teknik risk ve öncelikler netleşir.</p>
                    </div>

                    <div class="svc-step" data-svc-anim="step">
                        <span class="svc-step__num-pill">02</span>
                        <h3 class="svc-step__title">Mimari</h3>
                        <p class="svc-step__desc">Veri yapısı, entegrasyonlar, sayfa akışları ve teslim planı hazırlanır.</p>
                    </div>

                    <div class="svc-step" data-svc-anim="step">
                        <span class="svc-step__num-pill">03</span>
                        <h3 class="svc-step__title">Tasarım ve geliştirme</h3>
                        <p class="svc-step__desc">Arayüz, backend, AI veya otomasyon bileşenleri kontrollü şekilde üretilir.</p>
                    </div>

                    <div class="svc-step" data-svc-anim="step">
                        <span class="svc-step__num-pill">04</span>
                        <h3 class="svc-step__title">Test ve yayın</h3>
                        <p class="svc-step__desc">Performans, mobil görünüm, içerik, form ve kritik akışlar yayından önce kontrol edilir.</p>
                    </div>

                    <div class="svc-step" data-svc-anim="step">
                        <span class="svc-step__num-pill">05</span>
                        <h3 class="svc-step__title">Bakım</h3>
                        <p class="svc-step__desc">Sistem izlenir, geri bildirimler toplanır ve sonraki geliştirme adımları planlanır.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="svc-cta-section" aria-labelledby="servicesCtaHeading" data-svc-anim="fade">
        <div class="svc-container">
            <div class="svc-cta-wrapper">
                <div class="svc-cta">
                    <span class="svc-section__eyebrow">Sonraki adım</span>
                    <h2 id="servicesCtaHeading" class="svc-cta__title">
                        İhtiyacınıza uygun hizmet kapsamını birlikte netleştirelim.
                    </h2>
                    <p class="svc-cta__desc">
                        Mevcut fikrinizi, sisteminizi veya operasyonel probleminizi dinleyelim.
                        Size gerçekçi kapsam, teknik yol ve teslimat yaklaşımı önerelim.
                    </p>
                    <a class="svc-btn svc-btn--pill-primary" asp-controller="Contact" asp-action="Index">
                        İletişime geç
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M5 12h14M13 5l7 7-7 7" />
                        </svg>
                    </a>
                </div>
            </div>
        </div>
    </section>

</div>

@section Scripts {
    <script src="~/js/services.js" asp-append-version="true" defer></script>
}
